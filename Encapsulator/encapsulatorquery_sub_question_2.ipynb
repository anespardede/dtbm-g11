   "source": [
    "import psycopg2\n",
    "import pandas as pd\n",
    "from scipy import stats\n",
    "\n",
    "# Establish Database Connection\n",
    "conn = psycopg2.connect(\n",
    "    dbname=\"movies_11\",\n",
    "    user=\"postgres\",       
    "    password=\"04042002\",  
    "    host=\"localhost\",\n",
    "    port=\"5432\"\n",
    ")\n",
    "\n",
    "# Define the Encapsulated SQL Query\n",
    "query_sq2 = \"\"\"\n",
    "SELECT \n",
    "    m.movie_id,\n",
    "    m.title,\n",
    "    ms.worldwide_box_office,\n",
    "    COUNT(cr.consumer_review_id) AS review_volume,\n",
    "    ROUND(AVG(cr.review_score), 2) AS review_valence,\n",
    "    ROUND(\n",
    "        COALESCE(SUM(cr.thumbs_up)::NUMERIC / NULLIF(SUM(cr.thumbs_total), 0), 0), 4\n",
    "    ) AS helpfulness_ratio,\n",
    "    ROUND(AVG(cr.wc), 2) AS avg_word_count,\n",
    "    ROUND(AVG(cr.analytic), 2) AS avg_analytic_thinking,\n",
    "    ROUND(AVG(cr.clout), 2) AS avg_clout,\n",
    "    ROUND(AVG(cr.authentic), 2) AS avg_authenticity,\n",
    "    ROUND(AVG(cr.tone), 2) AS avg_emotional_tone,\n",
    "    ROUND(AVG(cr.posemo), 2) AS avg_positive_emotion,\n",
    "    ROUND(AVG(cr.negemo), 2) AS avg_negative_emotion\n",
    "FROM movie m\n",
    "JOIN movie_sales ms ON m.movie_id = ms.movie_id\n",
    "JOIN consumer_review cr ON m.movie_id = cr.movie_id\n",
    "WHERE ms.worldwide_box_office IS NOT NULL\n",
    "GROUP BY m.movie_id, m.title, ms.worldwide_box_office\n",
    "HAVING COUNT(cr.consumer_review_id) >= 5\n",
    "ORDER BY ms.worldwide_box_office DESC;\n",
    "\"\"\"\n",
    "\n",
    "# Load Data into DataFrame\n",
    "sq2_df = pd.read_sql(query_sq2, conn)\n"
   ]
  },
