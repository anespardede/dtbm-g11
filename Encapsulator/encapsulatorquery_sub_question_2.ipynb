   ],
   "source": [
    "# H1: Review Volume vs. Worldwide Box Office\n",
    "corr_h1, p_val_h1 = stats.pearsonr(sq2_df['review_volume'], sq2_df['worldwide_box_office'])\n",
    "print(f\"H1 (Volume): Correlation = {corr_h1:.4f}, p-value = {p_val_h1:.4e}\")\n",
    "\n",
    "# H2: Review Valence vs. Worldwide Box Office\n",
    "corr_h2, p_val_h2 = stats.pearsonr(sq2_df['review_valence'], sq2_df['worldwide_box_office'])\n",
    "print(f\"H2 (Valence): Correlation = {corr_h2:.4f}, p-value = {p_val_h2:.4e}\")\n",
    "\n",
    "# H3: Linguistic & Emotional Characteristics vs. Worldwide Box Office\n",
    "liwc_metrics = [\n",
    "    'avg_word_count',\n",
    "    'avg_analytic_thinking',\n",
    "    'avg_clout',\n",
    "    'avg_authenticity',\n",
    "    'avg_emotional_tone',\n",
    "    'avg_positive_emotion',\n",
    "    'avg_negative_emotion'\n",
    "]\n",
    "\n",
    "print(\"\\n--- H3 (LIWC Characteristics) Correlations ---\")\n",
    "for metric in liwc_metrics:\n",
    "    corr, p_val = stats.pearsonr(sq2_df[metric], sq2_df['worldwide_box_office'])\n",
    "    print(f\"H3 ({metric}): Correlation = {corr:.4f}, p-value = {p_val:.4e}\")\n"
   ]
